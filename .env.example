# Public identifier returned by the server only when creating an order.
RAZORPAY_KEY_ID=rzp_test_replace_me

# Server-only secret. Never place this value in frontend JavaScript or commit it.
RAZORPAY_KEY_SECRET=replace_me

# Registration price in Indian rupees; the server converts this to paise.
REGISTRATION_FEE_INR=1000

# Registrations -> Google Sheets (see google-sheets/SETUP.md)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/replace_me/exec
GOOGLE_SHEETS_SECRET=replace_me

# Optional: also store registrations in Supabase
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Check-in desk PIN for /checkin.html (volunteers only). Server-side only.
STAFF_PIN=replace_me
